{
  "manifest_version": 3,
  "name": "Jut.SU HBFS",
  "description": "Таймкоды достижений и компактная навигация по сериям Jut.su.",
  "version": "1.1.1",
  "icons": { "60": "images/icon60.png" },
  "content_scripts": [
    {
      "matches": ["https://*.jut.su/*"],
      "css": ["main.css"]
    },
    {
      "matches": ["https://*.jut.su/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
